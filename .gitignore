# macOS and local editors
.DS_Store
**/.DS_Store
.idea/
.vscode/
.codex_tmp/

# Python generated caches
__pycache__/
*.py[cod]

# Reproducible intermediate character review output.
# Keep source meshes, reports, scripts, and the documented/current previews.
/BlenderSource/Characters/C1B-RW-00[4-9]-preview/Renders/
/BlenderSource/Characters/C1B-RW-010-preview/Renders/
/BlenderSource/Characters/C1B-RW-01[2-5]-preview/Renders/
/BlenderSource/Characters/C1B-RW-017-pose-preview/*.blend
/BlenderSource/Characters/C1B-RW-017-pose-preview/Renders/
/BlenderSource/Characters/C1B-RW-019-global-candidates/*.blend

# Local pose reviews must be approved before publication.
/BlenderSource/Characters/C1B-RW-020-helper-rig-preview/PoseTests/*.png

# Unity generated directories (the project lives below the repository root)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Blender backup files are recoverable editor output; only canonical .blend
# sources may enter Git LFS.
*.blend[0-9]
*.blend[0-9][0-9]

# Unity/IDE generated solution files
*.csproj
*.sln
*.slnx
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Local build outputs. Player Builds remain user-run only.
**/[Bb]uild/
**/[Bb]uilds/

# Crash and profiler output
sysinfo.txt
*.stacktrace

# Never ignore Unity source metadata, project settings, or package locks.
!**/Assets/**/*.meta
!**/ProjectSettings/**
!**/Packages/manifest.json
!**/Packages/packages-lock.json
