* text=auto

# Repository text
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf

# Unity/C# text sources
*.cs text eol=lf diff=csharp
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.inputactions text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf

# Binary assets. Git LFS filters are intentionally not enabled until LFS and a
# remote are explicitly approved; see config/repository/BinaryAssetPolicy.md.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.bmp binary
*.psd binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.fbx binary
*.blend binary
*.glb binary
*.dll binary
*.so binary
*.dylib binary
*.bundle binary
*.zip binary
*.7z binary
